# Oriane — server-side only. Never ship this to the browser.
ORIANE_API="beta_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase — service role key bypasses RLS, server-side only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# LLM batch (offline only, temperature 0). Any OpenAI-compatible endpoint.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4.1-mini"

# Creator-stance ETL (optional, cloud)
GCP_PROJECT="your-gcp-project"
BQ_DATASET="cadrage2027"
VERTEX_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.5-flash"
# Local only; inside GCP the metadata server provides the token.
GOOGLE_ACCESS_TOKEN=""

# ── Supabase deployment ─────────────────────────────────────────────────────
# Personal access token (https://supabase.com/dashboard/account/tokens).
# Needed only to deploy; never shipped to the browser.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=your-project-ref
# Optional: require x-api-key on the GraphQL function.
GRAPHQL_TOKEN=
